# Compose host port. The app binds to 127.0.0.1 only.
BJJ_PORT=8000
# Maximum media upload size in bytes: 4 GiB.
BJJ_MAX_UPLOAD_BYTES=4294967296
# Individual microphone upload cap: 512 MiB (also bounded by total upload cap).
BJJ_MAX_VOICEOVER_BYTES=536870912
# Keep CPU headroom during native FFmpeg work.
BJJ_FFMPEG_THREADS=2
# Native development only (Compose sets these paths internally).
# BJJ_DATA_DIR=../data
# BJJ_FRONTEND_DIR=../frontend/dist
